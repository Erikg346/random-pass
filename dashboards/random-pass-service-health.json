            "data_source": {
              "type": "esql",
              "query": "FROM traces-generic.otel-default | WHERE processor.event == \"transaction\" | EVAL duration_ms = transaction.duration.us / 1000 | STATS requests = COUNT(*), failures = COUNT(*) WHERE event.outcome == \"failure\", p95_ms = PERCENTILE(duration_ms, 95) BY service.name | EVAL error_rate = ROUND(failures * 100.0 / requests, 2) | WHERE requests > 50 | SORT error_rate DESC | LIMIT 10"
