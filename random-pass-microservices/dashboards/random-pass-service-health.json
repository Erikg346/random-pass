          "config": {
            "title": "🐌 Slowest Transactions",
            "type": "data_table",
            "data_source": {
              "type": "esql",
              "query": "FROM traces-generic.otel-default | WHERE processor.event == \"transaction\" | EVAL duration_ms = transaction.duration.us / 1000 | STATS p95_ms = PERCENTILE(duration_ms, 95), p99_ms = PERCENTILE(duration_ms, 99), count = COUNT() BY service.name, name | SORT p95_ms DESC | LIMIT 25"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "metrics": [
              {
                "column": "p95_ms"
