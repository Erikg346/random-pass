        {
          "grid": {
            "y": 0,
            "x": 0,
            "w": 24,
            "h": 8
          },
          "config": {
            "title": "🔴 Recent Failures",
            "type": "data_table",
            "data_source": {
              "type": "esql",
              "query": "FROM traces-generic.otel-default | WHERE attributes.event.outcome == \"failure\" | STATS failure_count = COUNT(), latest = MAX(@timestamp) BY attributes.error.type | SORT latest DESC"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "metrics": [
              {
                "column": "failure_count"
              },
              {
                "column": "latest"
              }
            ],
            "rows": [
              {
                "column": "attributes.error.type"
              }
            ]
          },
          "id": "panel-recent-failures",
          "type": "vis"
        },
        {
          "grid": {
