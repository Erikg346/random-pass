        {
          "grid": {
            "y": 0,
            "x": 0,
            "w": 10,
            "h": 6
          },
          "config": {
            "title": "Availability %",
            "hide_title": true,
            "data_source": {
              "type": "esql",
              "query": "FROM traces-generic.otel-default | WHERE processor.event == \"transaction\" | STATS total = COUNT(*), success = COUNT(*) WHERE event.outcome == \"success\" | EVAL availability = ROUND(success * 100.0 / total, 2)"
            },
            "type": "metric",
            "sampling": 1,
            "ignore_global_filters": false,
            "metrics": [
              {
                "type": "primary",
                "column": "availability",
                "label": "Availability %",
                "color": {
                  "type": "auto"
                }
              }
            ],
            "styling": {
              "density": "default",
              "primary": {
                "position": "bottom",
                "labels": {
                  "alignment": "left"
                },
                "value": {
                  "sizing": "auto",
                  "alignment": "right"
                }
              }
            }
          },
